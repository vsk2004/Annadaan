# ─── Database ─────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/food_donation_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# ─── JWT ──────────────────────────────────────────────────────
# CHANGE THIS to a random 256-bit secret before production!
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-256-bits-long
JWT_EXPIRATION_MS=86400000

# ─── File Upload ──────────────────────────────────────────────
UPLOAD_DIR=uploads

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Email Service (Brevo transactional API) ──────────────────
BREVO_API_KEY=your_brevo_api_key
MAIL_FROM=projectannadaan@gmail.com
MAIL_FROM_NAME=Annadaan
FRONTEND_URL=http://localhost:5173
EMAIL_NOTIFICATION_RADIUS_KM=10.0

# ─── SMS Notifications (Twilio transactional API) ─────────────
SMS_ENABLED=false
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
APP_BASE_URL=http://localhost:5173
